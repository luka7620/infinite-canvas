# Docker image. Change this if you publish your own image.
APP_IMAGE=luka762/infinite-canvas:latest

# Host binding.
BIND_HOST=127.0.0.1
SERVER_PORT=3000

# Admin account created on first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# Must be fixed across restarts.
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# PostgreSQL.
POSTGRES_USER=infinite_canvas
POSTGRES_PASSWORD=
POSTGRES_DB=infinite_canvas
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10

# Redis cache and distributed lock.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=60
REDIS_KEY_PREFIX=infinite-canvas

TZ=Asia/Shanghai
